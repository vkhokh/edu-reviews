<div class="site-header">
  <%= link_to root_path, class: "site-logo" do %>
    Edu<span>Reviews</span>
  <% end %>

  <nav class="nav-links">
    <%= link_to "Курсы", courses_path %>
    <%= link_to "Преподаватели", teachers_path %>
  </nav>

  <div style="display: flex; align-items: center; gap: 10px;">
    <% if logged_in? %>
      <%= button_to "Выйти", session_path, method: :delete, class: "btn-primary", form: { style: "display:inline" } %>
    <% else %>
      <%= link_to "Войти", new_session_path, class: "btn-ghost" %>
      <%= link_to "Создать аккаунт →", new_registration_path, class: "btn-primary" %>
    <% end %>
  </div>
</div>
