<%# Список отзывов. locals: reviews, empty_text, show_course (необязательно)
    Контейнер #reviews_list есть всегда: в него Turbo Stream добавляет новые отзывы. %>
<% if reviews.empty? %>
  <p id="reviews_empty" style="text-align: center; color: var(--edu-text-muted);"><%= empty_text %></p>
<% end %>
<div id="reviews_list" style="display: flex; flex-direction: column; gap: 20px;">
  <% reviews.each do |review| %>
    <%= render "reviews/review", review: review, show_course: local_assigns[:show_course] %>
  <% end %>
</div>
